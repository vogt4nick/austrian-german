{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve",
      "type": "shell",
      // --dev-addr localhost:xxxx is necessary for embedded youtube videos
      // to work locally https://stackoverflow.com/questions/51969269/
      "command": "uv run zensical serve --dev-addr localhost:8000",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "uv run zensical build",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
